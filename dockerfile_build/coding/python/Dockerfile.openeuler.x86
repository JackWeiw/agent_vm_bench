# Coding Benchmark Template (openEuler, Python) - E2B Sandbox for AI Coding Agent Memory Stress Testing
#
# x86_64 variant of coding/python/Dockerfile.openeuler. Identical build, only the
# base image tag differs (openEuler 24.03-LTS-SP3 amd64). See Dockerfile.openeuler
# for the full design rationale.
#
# Build:  docker build -t openeuler-coding-python-bench:24.03-lts-sp3-x86_64 -f Dockerfile.openeuler.x86 .
# Push:   OS=openeuler ARCH=x86 HARBOR_IP=X bash push_to_harbor.sh
# Template: python3 ../../build_e2b.py --server-ip X --harbor-ip X \
#     --alias openeuler-coding-python-v1 --image e2b-orchestration/openeuler-coding-python-bench:custom
FROM openeuler-24.03-lts-sp3:latest

ENV DEBIAN_FRONTEND=noninteractive

ARG HTTP_PROXY=
ARG HTTPS_PROXY=
ENV http_proxy=${HTTP_PROXY}
ENV https_proxy=${HTTPS_PROXY}
ENV HTTP_PROXY=${HTTP_PROXY}
ENV HTTPS_PROXY=${HTTPS_PROXY}

RUN echo 'sslverify=0' >> /etc/dnf/dnf.conf && \
    dnf install -y python3 python3-pip git curl vim && \
    pip3 install --no-cache-dir --break-system-packages \
        -i https://pypi.tuna.tsinghua.edu.cn/simple \
        --trusted-host pypi.tuna.tsinghua.edu.cn \
        asgiref==3.8.1 sqlparse==0.5.0 && \
    git config --global http.sslVerify false && \
    dnf clean all && rm -rf /var/cache/dnf /var/tmp/* /tmp/*

# --- Coding benchmark project: django/django @ django__django-16631 base_commit ---
# The instance's test patch (tests/auth_tests/test_basic.py) is applied right
# after the checkout. The runner's reset only touches `django/`, so it is never
# reverted.
RUN cd /opt && mkdir coding-bench && cd coding-bench && \
    git init -q && \
    git remote add origin https://github.com/django/django.git && \
    git fetch -q --depth 1 origin 9b224579875e30203d079cc2fee83b116d98eb78 && \
    git checkout -q FETCH_HEAD

# `python` shim: the upstream eval runs `./tests/runtests.py` (shebang
# `#!/usr/bin/env python`) while openEuler ships only python3.
RUN mkdir -p /usr/local/bin && ln -sf /usr/bin/python3 /usr/local/bin/python

COPY tests/django-16631-test.patch /tmp/
RUN cd /opt/coding-bench && \
    git apply /tmp/django-16631-test.patch && \
    grep -q "def test_get_user_fallback_secret" tests/auth_tests/test_basic.py && \
    rm /tmp/django-16631-test.patch

# ENV PYTHONPATH makes django importable in script mode (python3 /tmp/...).
# No `pip install django` needed — django resolves from the cloned source via
# PYTHONPATH (asgiref/sqlparse are installed above).
ENV PYTHONPATH=/opt/coding-bench

RUN echo 'import django; from django.conf import settings; print("django", django.__version__)' > /tmp/_smoke.py && \
    python3 /tmp/_smoke.py && rm /tmp/_smoke.py

COPY bench_helper.sh /opt/coding-bench/bench_helper.sh
COPY bench_pairs.json /opt/coding-bench/bench_pairs.json
RUN chmod +x /opt/coding-bench/bench_helper.sh

ENV http_proxy= \
    https_proxy= \
    HTTP_PROXY= \
    HTTPS_PROXY=

CMD ["sleep", "infinity"]
