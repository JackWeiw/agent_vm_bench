# Coding Benchmark Template (Python) - E2B Sandbox for AI Coding Agent Memory Stress Testing
#
# x86_64 variant of coding/python/Dockerfile. Identical build, base image is the
# plain ubuntu:24.04 (amd64). See Dockerfile for the full design rationale.
#
# Build:  docker build -t ubuntu-openclaw-coding-python:24.04-x86_64 -f Dockerfile.x86 .
# Push:   ARCH=x86 HARBOR_IP=X bash push_to_harbor.sh
# Template: python3 ../../build_e2b.py --server-ip X --harbor-ip X \
#     --alias openclaw-coding-python-v1 --image e2b-orchestration/ubuntu-coding-python-bench:custom

FROM swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

ARG HTTP_PROXY=
ARG HTTPS_PROXY=
ENV http_proxy=${HTTP_PROXY}
ENV https_proxy=${HTTPS_PROXY}
ENV HTTP_PROXY=${HTTP_PROXY}
ENV HTTPS_PROXY=${HTTPS_PROXY}

RUN apt update && apt install -y --no-install-recommends python3 python3-pip git curl vim && \
    pip3 install --no-cache-dir --break-system-packages \
        -i https://pypi.tuna.tsinghua.edu.cn/simple \
        --trusted-host pypi.tuna.tsinghua.edu.cn \
        asgiref==3.8.1 sqlparse==0.5.0 && \
    git config --global http.sslVerify false && \
    apt clean && rm -rf /var/lib/apt/lists/* /var/tmp/* /tmp/*

# Fail the build (instead of silently drifting) if the interpreter the
# benchmark measures is not the version django 5.0 supports.
RUN python3 -c "import sys; assert sys.version_info[:2] == (3, 12), sys.version" && \
    echo "Toolchain check: python3 3.12"

# --- Coding benchmark project: django/django @ django__django-16631 base_commit ---
# Shallow-fetch exactly the instance base commit (no full history in the image).
# The instance's test patch (tests/auth_tests/test_basic.py) is applied right
# after the checkout. The runner's reset only touches `django/`, so the baked-in
# test patch is never reverted.
RUN cd /opt && mkdir coding-bench && cd coding-bench && \
    git init -q && \
    git remote add origin https://github.com/django/django.git && \
    git fetch -q --depth 1 origin 9b224579875e30203d079cc2fee83b116d98eb78 && \
    git checkout -q FETCH_HEAD

# `python` shim: the upstream eval runs `./tests/runtests.py` (shebang
# `#!/usr/bin/env python`) while Ubuntu 24.04 ships only python3.
RUN mkdir -p /usr/local/bin && ln -sf /usr/bin/python3 /usr/local/bin/python

COPY tests/django-16631-test.patch /tmp/
RUN cd /opt/coding-bench && \
    git apply /tmp/django-16631-test.patch && \
    grep -q "def test_get_user_fallback_secret" tests/auth_tests/test_basic.py && \
    rm /tmp/django-16631-test.patch

# django must resolve WITHOUT relying on image config: the E2B template
# pipeline runs `docker export | docker import`, which keeps the filesystem but
# drops ENV/CMD. An `ENV PYTHONPATH` therefore does NOT survive into the
# template. A `.pth` file in site-packages is filesystem state, so it does.
# No `pip install django` needed — the cloned tree IS the package.
RUN SITE_DIR="$(python3 -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')" && \
    printf '/opt/coding-bench\n' > "${SITE_DIR}/django-src.pth" && \
    echo "django source pinned via ${SITE_DIR}/django-src.pth"

# Smoke check with `env -i` (no inherited environment, i.e. the post-import
# state): only the .pth on disk can make django importable here.
RUN env -i /usr/bin/python3 -c 'import django; print("django", django.__version__)'

COPY bench_helper.sh /opt/coding-bench/bench_helper.sh
COPY bench_pairs.json /opt/coding-bench/bench_pairs.json
RUN chmod +x /opt/coding-bench/bench_helper.sh

ENV http_proxy= \
    https_proxy= \
    HTTP_PROXY= \
    HTTPS_PROXY=

CMD ["sleep", "infinity"]
