# Coding Benchmark Template (openEuler, Python) - E2B Sandbox for AI Coding Agent Memory Stress Testing
#
# Environment: Pure Python coding benchmark (NO browser/Chromium, NO agent tools,
# NO resident dev server, NO production build step)
#
# Project: django/django (https://github.com/django/django)
#   - 60k+ GitHub stars, the Django web framework (large popular Python monorepo)
#   - Real repo used across swe_bench / swe-bench-verified evaluations
#   - Toolchain: CPython (the interpreter an agent touches); stdlib+django verify scripts.
#   - Pure Python, ARM64 compatible
#
# Trace-faithful loop (mirrors the captured openclaw trajectories behind the ts/go
# variants): find -> read -> edit -> verify (write ad-hoc /tmp/test_*.py + `python3`)
# -> git diff. A real AI coding agent on django verifies by writing a small ad-hoc
# Python script that imports django's module graph and running it via `python3` —
# a transient interpreter process that loads the settings/urls/forms/db module graph
# into memory (the transient peak). N concurrent sandboxes' staggered verify peaks
# overlapping -> host memory overcommit.
#
# Prerequisite (Step 0 in README): the openEuler base tar is NOT on a pull-able
# registry. Load it before building:
#   wget https://repo.openeuler.org/openEuler-24.03-LTS-SP3/docker_img/aarch64/openEuler-docker.aarch64.tar.xz
#   xz -d openEuler-docker.aarch64.tar.xz
#   docker load -i openEuler-docker.aarch64.tar   # -> openeuler-24.03-lts-sp3:latest
#
# Build:  docker build -t openeuler-coding-python-bench:24.03-lts-sp3-linuxarm64 -f Dockerfile.openeuler .
# Push:   OS=openeuler HARBOR_IP=X bash push_to_harbor.sh
# Template: python3 ../build_e2b.py --server-ip X --harbor-ip X \
#     --alias openeuler-coding-python-v1 --image e2b-orchestration/openeuler-coding-python-bench:custom
FROM openeuler-24.03-lts-sp3:latest

ENV DEBIAN_FRONTEND=noninteractive

ARG HTTP_PROXY=
ARG HTTPS_PROXY=
ENV http_proxy=${HTTP_PROXY}
ENV https_proxy=${HTTPS_PROXY}
ENV HTTP_PROXY=${HTTP_PROXY}
ENV HTTPS_PROXY=${HTTPS_PROXY}

# openEuler package names: python3 + python3-pip via dnf (dnf, not apt).
# --no-install-recommends has no dnf equivalent; the corp proxy presents a
# self-signed cert, so dnf skips SSL (sslverify=0) and git skips it too.
RUN echo 'sslverify=0' >> /etc/dnf/dnf.conf && \
    dnf install -y python3 python3-pip git curl vim && \
    pip3 install --no-cache-dir --break-system-packages \
        -i https://pypi.tuna.tsinghua.edu.cn/simple \
        --trusted-host pypi.tuna.tsinghua.edu.cn \
        asgiref==3.8.1 sqlparse==0.5.0 && \
    git config --global http.sslVerify false && \
    dnf clean all && rm -rf /var/cache/dnf /var/tmp/* /tmp/*

RUN cd /opt && \
    git clone https://github.com/django/django.git coding-bench && \
    cd coding-bench && \
    git checkout 8d160f154f0240a423e83ffe0690e472f837373c && \
    python3 -c "import django; from django.conf import settings; print('django', django.__version__)"

COPY bench_helper.sh /opt/coding-bench/bench_helper.sh
RUN chmod +x /opt/coding-bench/bench_helper.sh

ENV http_proxy= \
    https_proxy= \
    HTTP_PROXY= \
    HTTPS_PROXY=

CMD ["sleep", "infinity"]
