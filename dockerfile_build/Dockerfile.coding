# Coding Benchmark Template - E2B Sandbox for AI Coding Agent Memory Stress Testing
#
# Environment: Pure coding benchmark (NO browser/Chromium, NO agent tools)
#
# Project: vuejs/core (https://github.com/vuejs/core)
#   - 54k+ GitHub stars, Vue.js core framework (TypeScript monorepo, pnpm)
#   - Real repo from the swe_bench_multilingual evaluation dataset (5 instances)
#   - Build: rollup (production) + esbuild (dev) — fast, low CPU
#   - 52 devDependencies (vue + compiler + reactivity + vite + rollup + esbuild)
#   - Pure JS/TS, ARM64 compatible
#
# Memory pressure model:
# - A persistent vite dev server runs in the background (~1.5GB) — agents
#   editing a frontend library like Vue run a local vite dev/HMR playground to
#   verify changes live (real development behavior). The wide vue+rollup+esbuild
#   dependency graph is what keeps it resident — the memory-overcommit carrier.
# - Production build (node scripts/build.js) peaks at ~1GB during verification.
# - Overlapping peak: dev server + build simultaneously active → ~3GB per sandbox.
# - Multiple concurrent sandboxes → overlapping peaks → host memory stress.
#
# Build:  docker build -t ubuntu-coding-bench:24.04-linuxarm64 -f Dockerfile.coding .
# Push:   HARBOR_IP=X bash push_to_harbor_coding.sh
# Template: python3 build_e2b.py --server-ip X --harbor-ip X --alias coding-bench-v1 --image e2b-orchestration/ubuntu-coding-bench:custom

FROM swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/ubuntu:24.04-linuxarm64

# Set environment variables to avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Configure proxy (empty by default, set via --build-arg if needed)
ARG HTTP_PROXY=
ARG HTTPS_PROXY=
ENV http_proxy=${HTTP_PROXY}
ENV https_proxy=${HTTPS_PROXY}
ENV HTTP_PROXY=${HTTP_PROXY}
ENV HTTPS_PROXY=${HTTPS_PROXY}

# Install Node24 and system packages
RUN apt update && apt install -y wget xz-utils vim libgomp1 iproute2 net-tools gnupg git && \
    cd /usr/local && \
    wget --no-check-certificate https://nodejs.org/dist/v24.14.0/node-v24.14.0-linux-arm64.tar.xz && \
    tar -xvf node-v24.14.0-linux-arm64.tar.xz && \
    mv node-v24.14.0-linux-arm64 node24 && \
    rm -rf node-v24.14.0-linux-arm64.tar.xz && \
    ln -sf /usr/local/node24/bin/node /usr/local/bin/node && \
    ln -sf /usr/local/node24/bin/npm /usr/local/bin/npm && \
    ln -sf /usr/local/node24/bin/npx /usr/local/bin/npx && \
    # Install pnpm@11.13.0 (matches vuejs/core packageManager) via its mirrored
    # tarball. corepack's metadata fetch against npmmirror fails (pnpm uses a
    # special publish mechanism; npmjs has no tarball, npmmirror mirrors one at
    # /pnpm/-/pnpm-<ver>.tgz). wget the tarball + npm i -g sidesteps corepack.
    npm config set strict-ssl false && \
    npm config set registry https://registry.npmmirror.com && \
    wget --no-check-certificate -O /tmp/pnpm.tgz https://registry.npmmirror.com/pnpm/-/pnpm-11.13.0.tgz && \
    npm install -g /tmp/pnpm.tgz --registry=https://registry.npmmirror.com --strict-ssl=false && \
    rm -f /tmp/pnpm.tgz && \
    ln -sf /usr/local/node24/bin/pnpm /usr/local/bin/pnpm && \
    ln -sf /usr/local/node24/bin/pnpx /usr/local/bin/pnpx && \
    # Verify the installed pnpm is the version we expect (11.13.0). Build fails
    # fast if a stale shim/PATH shadowing resolves a different version.
    pnpm --version | grep -qx "11.13.0" || (echo "pnpm version mismatch, got: $(pnpm --version)" && exit 1) && \
    git config --global http.sslVerify false && \
    apt clean && rm -rf /var/lib/apt/lists/* /var/tmp/* /tmp/*

# --- Coding benchmark project: vuejs/core (real swe_bench_multilingual repo) ---
# Clone, install dependencies, build, and init git for modification tracking.
# vuejs/core is a pnpm monorepo. pnpm@11 is declared via packageManager; corepack
# or the global pnpm installs against npmmirror. Build uses `node scripts/build.js`
# (rollup). The dev server is a separate vite playground consuming the built lib.
# PUPPETEER_SKIP_DOWNLOAD=1 skips puppeteer's browser download (not needed for build).
RUN cd /opt && \
    git clone --depth 1 https://github.com/vuejs/core.git coding-bench && \
    cd coding-bench && \
    # pnpm install against the mirror; rollup must be in PATH for build.js
    pnpm config set registry https://registry.npmmirror.com && \
    pnpm config set strict-ssl false && \
    PUPPETEER_SKIP_DOWNLOAD=1 pnpm install --frozen-lockfile=false && \
    # Add pnpm bin to PATH so rollup can be found by scripts/build.js
    export PATH="$(pnpm bin):$PATH" && \
    node scripts/build.js && \
    test -d packages/vue/dist && \
    echo "Build verification: SUCCESS (packages/vue/dist has output)"

# --- Vite dev-server playground (background memory pressure) ---
# A real agent editing a frontend library like Vue runs a local vite dev/HMR
# playground to verify changes live. This minimal app imports the built lib so
# the vite dev server holds the full vue + rollup + esbuild module graph resident
# (~1.5GB) — the memory-overcommit carrier. `npm run dev` here starts it.
RUN mkdir -p /opt/vite-playground/src && cd /opt/vite-playground && \
    printf '%s\n' \
      '{' \
      '  "name": "vite-playground",' \
      '  "version": "1.0.0",' \
      '  "private": true,' \
      '  "scripts": { "dev": "vite --port 5173 --host" },' \
      '  "dependencies": { "vue": "file:/opt/coding-bench/packages/vue" },' \
      '  "devDependencies": { "vite": "^6.0.0", "@vitejs/plugin-vue": "^5.0.0" }' \
      '}' > package.json && \
    printf '%s\n' \
      '<!DOCTYPE html>' \
      '<html lang="en"><head><meta charset="UTF-8"><title>Bench</title></head>' \
      '<body><div id="app"></div><script type="module" src="/src/main.ts"></script></body>' \
      '</html>' > index.html && \
    printf '%s\n' \
      "import { createApp } from 'vue'" \
      "createApp({ template: '<div>bench</div>' }).mount('#app')" > src/main.ts && \
    printf '%s\n' \
      "import { defineConfig } from 'vite'" \
      "import vue from '@vitejs/plugin-vue'" \
      "export default defineConfig({ plugins: [vue()] })" > vite.config.ts && \
    npm install --registry=https://registry.npmmirror.com --strict-ssl=false && \
    echo "Vite playground ready"

# Copy the manual testing helper script
COPY bench_helper.sh /opt/coding-bench/bench_helper.sh
RUN chmod +x /opt/coding-bench/bench_helper.sh

# Unset proxy environment variables after build
# Set BROWSER=none to prevent npm scripts from trying to open browser (no display in sandbox)
ENV http_proxy= \
    https_proxy= \
    HTTP_PROXY= \
    HTTPS_PROXY= \
    BROWSER=none

# Default command: keep container running for sandbox access
CMD ["sleep", "infinity"]