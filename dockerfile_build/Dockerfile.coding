# Coding Benchmark Template - E2B Sandbox for AI Coding Agent Memory Stress Testing
#
# This Dockerfile creates a Firecracker microVM template containing:
# - Node.js 24 runtime
# - React + webpack5 coding benchmark project (40 components)
# - Pre-installed node_modules (no npm install needed at runtime)
# - Pre-built initial webpack production build
#
# Memory pressure model:
# - Each "npm run build" = full production webpack rebuild (500-800MB peak)
# - Each round modifies bench-marker.ts → triggers genuine rebuild
# - Multiple concurrent sandboxes → overlapping build peaks → host memory stress
#
# Build: docker build -t ubuntu-coding-bench:24.04-linuxarm64 -f Dockerfile.coding .
# Push:  HARBOR_IP=X bash push_to_harbor_coding.sh
# Template: python3 build_e2b.py --server-ip X --harbor-ip X --alias openclaw-coding-v1 --image e2b-orchestration/ubuntu-coding-bench:custom

FROM swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/ubuntu:24.04-linuxarm64

# Set environment variables to avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Configure proxy (empty by default, set via --build-arg if needed)
ARG HTTP_PROXY=
ARG HTTPS_PROXY=
ENV http_proxy=${HTTP_PROXY}
ENV https_proxy=${HTTPS_PROXY}
ENV HTTP_PROXY=${HTTP_PROXY}
ENV HTTPS_PROXY=${HTTPS_PROXY}

# Install system packages needed for coding environment
# git: needed for project management and git checkout/reset operations
# vim: editor for manual sandbox testing
# build-essential: some npm packages need C compilation (node-gyp)
RUN apt update && apt install -y \
    git vim wget xz-utils build-essential \
    libgomp1 iproute2 net-tools \
    python3 python3-pip \
    && apt clean && rm -rf /var/lib/apt/lists/* /var/tmp/* /tmp/*

# Install Node24 (same as browser template)
RUN cd /usr/local && \
    wget --no-check-certificate https://nodejs.org/dist/v24.14.0/node-v24.14.0-linux-arm64.tar.xz && \
    tar -xvf node-v24.14.0-linux-arm64.tar.xz && \
    mv node-v24.14.0-linux-arm64 node24 && \
    rm -rf node-v24.14.0-linux-arm64.tar.xz && \
    ln -sf /usr/local/node24/bin/node /usr/local/bin/node && \
    ln -sf /usr/local/node24/bin/npm /usr/local/bin/npm && \
    ln -sf /usr/local/node24/bin/npx /usr/local/bin/npx && \
    git config --global http.sslVerify false

# Configure npm (use Chinese mirror for faster downloads on ARM64)
RUN npm config set strict-ssl false && \
    npm config set registry https://registry.npmmirror.com

# Copy and run the project setup script
# This generates the React + webpack5 project with 40 components,
# installs dependencies, runs initial build, and initializes git repo
COPY setup_coding_project.sh /tmp/setup_coding_project.sh
RUN bash /tmp/setup_coding_project.sh && rm /tmp/setup_coding_project.sh

# Verify the project works
RUN cd /opt/coding-bench && npm run build && echo "Build verification: SUCCESS"

# Add a simple benchmark helper script for manual testing
RUN cat > /opt/coding-bench/bench_helper.sh << 'HELPER'
#!/bin/bash
# Helper script for manual benchmark testing inside sandbox
# Usage: bash /opt/coding-bench/bench_helper.sh [round_number]

ROUND="${1:-0}"
PROJECT="/opt/coding-bench"

echo "=== Coding Bench Helper - Round ${ROUND} ==="
echo ""

# Step 1: Modify bench-marker.ts
echo "[Step 1: edit_file] Modifying bench-marker.ts for round ${ROUND}..."
sed -i "s/export const BENCH_ROUND = .*/export const BENCH_ROUND = ${ROUND};/" ${PROJECT}/src/bench-marker.ts
echo "  BENCH_ROUND updated to ${ROUND}"
echo ""

# Step 2: Run production build
echo "[Step 2: build] Running webpack production build..."
BUILD_START=$(date +%s%N)
cd ${PROJECT} && npm run build 2>&1 | tail -5
BUILD_END=$(date +%s%N)
BUILD_MS=$(( (BUILD_END - BUILD_START) / 1000000 ))
echo "  Build completed in ${BUILD_MS}ms"
echo ""

# Step 3: Run tests
echo "[Step 3: test] Running jest tests..."
TEST_START=$(date +%s%N)
cd ${PROJECT} && npm test 2>&1 | tail -10
TEST_END=$(date +%s%N)
TEST_MS=$(( (TEST_END - TEST_START) / 1000000 ))
echo "  Tests completed in ${TEST_MS}ms"
echo ""

# Step 4: Memory report
echo "[Memory Report] Current memory usage:"
free -m
echo ""
echo "=== Round ${ROUND} Complete ==="
echo "  Build time:  ${BUILD_MS}ms"
echo "  Test time:   ${TEST_MS}ms"
HELPER

RUN chmod +x /opt/coding-bench/bench_helper.sh

# Unset proxy environment variables after build
ENV http_proxy= \
    https_proxy= \
    HTTP_PROXY= \
    HTTPS_PROXY=

# Default command: keep sandbox alive (E2B runtime manages the sandbox lifecycle)
CMD ["sleep", "infinity"]
